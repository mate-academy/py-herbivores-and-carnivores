[flake8]
# --- Ignorowane błędy ---
# Q000  -> brak cudzysłowów "smart quotes" (flake8-quotes)
# E203  -> kolizja z Black (przestrzeń przed ':')
# W503  -> kolizja z PEP8 (złamana linia przed operatorem)
ignore = Q000, E203, W503

# --- Maksymalna długość linii ---
max-line-length = 120

# --- Wyłączone katalogi ---
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    tests,
    */tests/*,
    */migrations/*,
    *.pyc
